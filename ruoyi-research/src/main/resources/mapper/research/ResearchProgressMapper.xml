<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.research.mapper.ResearchProgressMapper">
    <resultMap id="ProgressResult" type="ResearchProgress">
        <id property="progressId" column="progress_id"/>
        <result property="projectId" column="project_id"/>
        <result property="recordDate" column="record_date"/>
        <result property="progressPercent" column="progress_percent"/>
        <result property="completedWork" column="completed_work"/>
        <result property="issues" column="issues"/>
        <result property="nextPlan" column="next_plan"/>
        <result property="recorderUserId" column="recorder_user_id"/>
        <result property="recorderName" column="recorder_name"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    <select id="selectByProjectId" resultMap="ProgressResult">
        select p.*, u.nick_name recorder_name from research_progress p
        left join sys_user u on u.user_id = p.recorder_user_id
        where p.project_id=#{projectId} order by p.record_date desc, p.progress_id desc
    </select>
    <insert id="insertProgress" parameterType="ResearchProgress" useGeneratedKeys="true" keyProperty="progressId">
        insert into research_progress(project_id,record_date,progress_percent,completed_work,issues,next_plan,recorder_user_id,create_by,create_time)
        values(#{projectId},#{recordDate},#{progressPercent},#{completedWork},#{issues},#{nextPlan},#{recorderUserId},#{createBy},sysdate())
    </insert>
</mapper>
